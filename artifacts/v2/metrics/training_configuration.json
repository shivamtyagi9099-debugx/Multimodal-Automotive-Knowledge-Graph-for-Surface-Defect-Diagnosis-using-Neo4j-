      "name": "classification_head",
      "trainable": "head",
      "epoch_count": 5,
      "learning_rate": 0.001
    },
    {
      "name": "full_fine_tuning",
      "trainable": "all",
      "epoch_count": 25,
      "learning_rate": 5e-05
    }
  ],
  "confidence_threshold": 0.6,
  "threshold_tuning": {
    "enabled": true,
    "minimum_coverage": 0.65,
    "candidate_thresholds": [
