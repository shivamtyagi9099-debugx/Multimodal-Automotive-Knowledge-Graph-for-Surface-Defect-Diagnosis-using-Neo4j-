      0.55,
      0.6,
      0.65,
      0.7,
      0.75,
      0.8,
      0.85,
      0.9
    ]
  },
  "model_output_path": "artifacts/v2/models/model.pt",
  "history_output_path": "artifacts/v2/metrics/training_history.json",
  "validation_threshold_output_path": "artifacts/v2/metrics/validation_threshold_analysis.json",
